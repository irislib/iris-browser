{
  "name": "iris-browser",
  "private": true,
  "type": "module",
  "description": "Standalone workspace for the Iris native browser shell",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-browser",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-browser",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-browser?tab=issues"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --dir apps/iris dev",
    "build": "pnpm --dir apps/iris build",
    "dev:site": "pnpm --dir apps/browser-site dev",
    "build:site": "pnpm --dir apps/browser-site build",
    "preview:site": "pnpm --dir apps/browser-site preview",
    "test:site": "pnpm --dir apps/browser-site test",
    "release:site": "pnpm --dir apps/browser-site release:site",
    "test": "pnpm --dir apps/iris test",
    "test:release": "pnpm --dir apps/iris test:release",
    "test:icons": "pnpm --dir apps/iris test:icons",
    "test:zapstore": "pnpm --dir apps/iris test:zapstore",
    "test:e2e": "pnpm --dir apps/iris test:e2e",
    "test:rust": "pnpm --dir apps/iris test:rust",
    "tauri:dev": "pnpm --dir apps/iris tauri:dev",
    "tauri:build": "pnpm --dir apps/iris tauri:build",
    "tauri:build:android": "pnpm --dir apps/iris tauri:build:android",
    "release:native": "pnpm --dir apps/iris release:native",
    "test:native:linux": "pnpm --dir apps/iris test:native:linux",
    "test:native:docker": "pnpm --dir apps/iris test:native:docker"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
